<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold">Suas Fichas de Personagem</h1>
  <%= link_to "← Voltar para Home", root_path, class: "bg-gray-600 hover:bg-gray-700 text-amber-50 px-4 py-2 rounded-lg" %>
</div>

<% if @character_sheets.any? %>
  <ul class="space-y-4">
    <% @character_sheets.each do |sheet| %>
      <li class="bg-gray-700 rounded-lg p-4">
        <strong><%= sheet.character_name %></strong>
        <span>
          (<%= sheet.race&.humanize %> <%= sheet.character_class&.humanize %>, Nível <%= sheet.level %>)
        </span>
        <%= link_to "Ver detalhes", character_sheet_path(sheet), class: "ml-4 text-blue-400 hover:text-blue-300" %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="bg-gray-700 p-4 rounded-lg">Você ainda não criou nenhuma ficha de personagem.</p>
<% end %>
